<Window x:Class="DocumentManagement.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="收文管理系统" 
        Height="768" 
        Width="1024"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <materialDesign:DialogHost Identifier="RootDialog">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 顶部菜单栏 -->
            <materialDesign:ColorZone Grid.Row="0" 
                                    Padding="16" 
                                    materialDesign:ShadowAssist.ShadowDepth="Depth2"
                                    Mode="PrimaryMid">
                <DockPanel>
                    <!-- 系统标题 -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <materialDesign:PackIcon Kind="FileDocument" 
                                               Width="32" 
                                               Height="32" 
                                               VerticalAlignment="Center"/>
                        <TextBlock Text="收文管理系统" 
                                 VerticalAlignment="Center" 
                                 Margin="16,0,0,0" 
                                 FontSize="20" 
                                 FontWeight="Bold"/>
                    </StackPanel>

                    <!-- 右侧用户信息 -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button Style="{StaticResource MaterialDesignFlatButton}" 
                              Content="设置" 
                              Margin="5,0"/>
                        <Button Style="{StaticResource MaterialDesignFlatButton}" 
                              Content="帮助" 
                              Margin="5,0"/>
                        <Button Style="{StaticResource MaterialDesignFlatButton}" 
                              Content="退出" 
                              Margin="5,0"
                              Click="ExitButton_Click"/>
                    </StackPanel>

                    <!-- 中间工具栏 -->
                    <StackPanel Orientation="Horizontal" 
                              HorizontalAlignment="Center">
                        <Button x:Name="NewDocumentButton"
                              Style="{StaticResource ToolbarButtonStyle}" 
                              Content="新建收文"
                              Click="NewDocumentButton_Click">
                            <Button.ToolTip>
                                <ToolTip Content="创建新的收文文档"/>
                            </Button.ToolTip>
                        </Button>
                        <Button x:Name="RefreshButton"
                              Style="{StaticResource ToolbarButtonStyle}" 
                              Content="刷新"
                              Click="RefreshButton_Click">
                            <Button.ToolTip>
                                <ToolTip Content="刷新文档列表"/>
                            </Button.ToolTip>
                        </Button>
                        <Button x:Name="SearchButton"
                              Style="{StaticResource ToolbarButtonStyle}" 
                              Content="搜索"
                              Click="SearchButton_Click">
                            <Button.ToolTip>
                                <ToolTip Content="搜索文档"/>
                            </Button.ToolTip>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </materialDesign:ColorZone>

            <!-- 主内容区域 -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧导航栏 -->
                <Border Grid.Column="0" Style="{StaticResource SidebarStyle}">
                    <StackPanel>
                        <!-- 快速统计 -->
                        <materialDesign:Card Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="快速统计" 
                                         FontWeight="Bold" 
                                         FontSize="14" 
                                         Margin="0,0,0,10"/>
                                
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="总文档数"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TotalCountText" Text="0" FontWeight="Bold"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="待办文档"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="PendingCountText" Text="0" FontWeight="Bold" Foreground="Orange"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="今日收文"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TodayCountText" Text="0" FontWeight="Bold" Foreground="Green"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="紧急文档"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="UrgentCountText" Text="0" FontWeight="Bold" Foreground="Red"/>
                                </Grid>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- 快速筛选 -->
                        <materialDesign:Card Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="快速筛选" 
                                         FontWeight="Bold" 
                                         FontSize="14" 
                                         Margin="0,0,0,10"/>

                                <Button x:Name="AllDocumentsButton" 
                                      Style="{StaticResource MaterialDesignFlatButton}" 
                                      Content="全部文档" 
                                      HorizontalAlignment="Stretch"
                                      Click="FilterButton_Click"
                                      Tag="All"/>
                                
                                <Button x:Name="PendingDocumentsButton" 
                                      Style="{StaticResource MaterialDesignFlatButton}" 
                                      Content="待办文档" 
                                      HorizontalAlignment="Stretch"
                                      Click="FilterButton_Click"
                                      Tag="Pending"/>
                                
                                <Button x:Name="CompletedDocumentsButton" 
                                      Style="{StaticResource MaterialDesignFlatButton}" 
                                      Content="已完成文档" 
                                      HorizontalAlignment="Stretch"
                                      Click="FilterButton_Click"
                                      Tag="Completed"/>
                                
                                <Button x:Name="UrgentDocumentsButton" 
                                      Style="{StaticResource MaterialDesignFlatButton}" 
                                      Content="紧急文档" 
                                      HorizontalAlignment="Stretch"
                                      Click="FilterButton_Click"
                                      Tag="Urgent"/>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- 搜索框 -->
                        <materialDesign:Card Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="搜索文档" 
                                         FontWeight="Bold" 
                                         FontSize="14" 
                                         Margin="0,0,0,10"/>
                                
                                <TextBox x:Name="SearchTextBox" 
                                       materialDesign:HintAssist.Hint="输入关键词搜索"
                                       KeyDown="SearchTextBox_KeyDown"/>
                                
                                <Button x:Name="SearchExecuteButton" 
                                      Style="{StaticResource ActionButtonStyle}" 
                                      Content="搜索" 
                                      Margin="0,10,0,0"
                                      Click="SearchExecuteButton_Click"/>
                            </StackPanel>
                        </materialDesign:Card>
                    </StackPanel>
                </Border>

                <!-- 右侧主内容区域 -->
                <Border Grid.Column="1" Style="{StaticResource MainContentStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 内容标题栏 -->
                        <Border Grid.Row="0" 
                              Background="{DynamicResource MaterialDesignPaper}" 
                              Padding="0,0,0,10">
                            <DockPanel>
                                <TextBlock x:Name="ContentTitle" 
                                         Text="全部文档" 
                                         Style="{StaticResource TitleTextStyle}"
                                         DockPanel.Dock="Left"/>
                                
                                <StackPanel Orientation="Horizontal" 
                                          DockPanel.Dock="Right"
                                          VerticalAlignment="Center">
                                    <Button x:Name="EditDocumentButton" 
                                          Style="{StaticResource ActionButtonStyle}" 
                                          Content="编辑"
                                          Click="EditDocumentButton_Click"/>
                                    <Button x:Name="DeleteDocumentButton" 
                                          Style="{StaticResource ActionButtonStyle}" 
                                          Content="删除"
                                          Click="DeleteDocumentButton_Click"/>
                                    <Button x:Name="ViewDocumentButton" 
                                          Style="{StaticResource ActionButtonStyle}" 
                                          Content="查看详情"
                                          Click="ViewDocumentButton_Click"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- 文档列表 -->
                        <DataGrid x:Name="DocumentsDataGrid" 
                                Grid.Row="1"
                                Style="{StaticResource DataGridStyle}"
                                SelectionChanged="DocumentsDataGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="文档标题" Binding="{Binding Title}" Width="200"/>
                                <DataGridTextColumn Header="文档编号" Binding="{Binding DocumentNumber}" Width="120"/>
                                <DataGridTextColumn Header="发文单位" Binding="{Binding SenderUnit}" Width="120"/>
                                <DataGridTextColumn Header="收文日期" Binding="{Binding ReceivedDate, StringFormat=yyyy-MM-dd}" Width="100"/>
                                <DataGridTextColumn Header="紧急程度" Binding="{Binding UrgencyLevel}" Width="80"/>
                                <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="80"/>
                                <DataGridTextColumn Header="负责人" Binding="{Binding ResponsibleUser.FullName}" Width="100"/>
                                <DataGridTextColumn Header="创建时间" Binding="{Binding CreatedTime, StringFormat=yyyy-MM-dd HH:mm}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- 底部状态栏 -->
            <materialDesign:ColorZone Grid.Row="2" 
                                    Padding="16,8" 
                                    Mode="PrimaryDark">
                <DockPanel>
                    <TextBlock x:Name="StatusText" 
                             Text="就绪" 
                             DockPanel.Dock="Left"/>
                    
                    <TextBlock x:Name="UserInfoText" 
                             Text="当前用户：系统管理员" 
                             DockPanel.Dock="Right"/>
                    
                    <TextBlock x:Name="TimeText" 
                             Text=""
                             HorizontalAlignment="Center"/>
                </DockPanel>
            </materialDesign:ColorZone>
        </Grid>
    </materialDesign:DialogHost>
</Window>