<Window x:Class="DocumentManagement.WPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="收文管理系统" Height="600" Width="1000"
        WindowStartupLocation="CenterScreen">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="#2196F3" Padding="10">
            <TextBlock Text="收文管理系统" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
        </Border>
        
        <!-- 搜索和操作栏 -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <Grid Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="搜索:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                         VerticalAlignment="Center" Padding="5"/>
                <Button Grid.Column="2" Content="搜索" Command="{Binding SearchCommand}" 
                        Margin="5,0,0,0" Padding="10,5"/>
            </Grid>
            
            <Button Grid.Column="1" Content="新增" Command="{Binding AddDocumentCommand}" 
                    Margin="5,0" Padding="10,5" Background="#4CAF50" Foreground="White"/>
            <Button Grid.Column="2" Content="编辑" Command="{Binding EditDocumentCommand}" 
                    Margin="5,0" Padding="10,5" Background="#FF9800" Foreground="White"/>
            <Button Grid.Column="3" Content="删除" Command="{Binding DeleteDocumentCommand}" 
                    Margin="5,0" Padding="10,5" Background="#F44336" Foreground="White"/>
            <Button Grid.Column="4" Content="刷新" Command="{Binding RefreshCommand}" 
                    Margin="5,0" Padding="10,5" Background="#2196F3" Foreground="White"/>
        </Grid>
        
        <!-- 文档列表 -->
        <DataGrid Grid.Row="2" 
                  ItemsSource="{Binding Documents}"
                  SelectedItem="{Binding SelectedDocument}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  Margin="10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="收文编号" Binding="{Binding DocumentNumber}" Width="120"/>
                <DataGridTextColumn Header="标题" Binding="{Binding Title}" Width="*"/>
                <DataGridTextColumn Header="发文单位" Binding="{Binding SenderUnit}" Width="150"/>
                <DataGridTextColumn Header="收文日期" Binding="{Binding ReceiveDate, StringFormat={}{0:yyyy-MM-dd}}" Width="100"/>
                <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="80"/>
                <DataGridTextColumn Header="承办人" Binding="{Binding Handler}" Width="80"/>
                <DataGridTextColumn Header="承办部门" Binding="{Binding Department}" Width="100"/>
                <DataGridTextColumn Header="紧急程度" Binding="{Binding Urgency}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>
        
        <!-- 状态栏 -->
        <StatusBar Grid.Row="3">
            <StatusBarItem>
                <TextBlock Text="{Binding Documents.Count, StringFormat=共 {0} 条记录}"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <ProgressBar Width="100" Height="16" IsIndeterminate="{Binding IsLoading}" 
                           Visibility="{Binding IsLoading, Converter={x:Static BooleanToVisibilityConverter.Default}}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>